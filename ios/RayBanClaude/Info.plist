<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>RayBan Claude</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>it</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>RayBan Claude usa la fotocamera per permettere a Claude di vedere ciò che gli mostri e per riconoscere i codici QR.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>RayBan Claude usa il microfono per permetterti di parlare a voce con Claude.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>RayBan Claude trasforma la tua voce in testo direttamente sull’iPhone.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Per «Ricordami domani alle 9 di …» RayBan Claude crea voci nell’app Promemoria.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Per «Ricordami domani alle 9 di …» RayBan Claude crea voci nell’app Promemoria.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Per «Scatta una foto» RayBan Claude salva la foto degli occhiali nella tua libreria Foto.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Per «Dove sono?» e «Ricorda dove ho parcheggiato» RayBan Claude rileva la posizione una sola volta, solo quando lo chiedi tu.</string>
	<key>NSContactsUsageDescription</key>
	<string>Per far funzionare «Chiama la mamma», RayBan Claude cerca il nome nei tuoi contatti, solo sull’iPhone: i numeri non vengono inviati a Claude.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>RayBan Claude si collega al tuo PC sulla rete Wi-Fi locale e ai tuoi Ray-Ban Meta.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>RayBan Claude usa il Bluetooth per collegarsi ai Ray-Ban Meta (fotocamera, microfono, altoparlante).</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>raybanclaude</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>raybanclaude://</string>
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>ClientToken</key>
		<string>$(META_CLIENT_TOKEN)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
		<key>CrashReporting</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
</dict>
</plist>
